# Copy to the repository root as .env.staging.local (ignored by git through the existing "*.local" rule).
# Values come from the ISOLATED Supabase project: Project Settings -> API. Public values only:
# never put a service-role key or database password in this file.
VITE_SUPABASE_PROJECT_ID="<isolated project ref>"
VITE_SUPABASE_URL="https://<isolated project ref>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="<isolated project anon / publishable key>"
