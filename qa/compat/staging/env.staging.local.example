# Keep this file OUTSIDE the repository (e.g. ~/AfiyeatStaging/.env.staging.local).
# Three PUBLIC values from the STAGING project (Project Settings -> API). Nothing else belongs here:
# prepare-iphone-staging.sh refuses any other setting, a service_role key, and the production project.
VITE_SUPABASE_PROJECT_ID="<staging project ref>"
VITE_SUPABASE_URL="https://<staging project ref>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="<staging anon / publishable key>"
